# Variables de entorno del backend (en IntelliJ: Run > Edit Configurations > Environment variables)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=pokestore
DB_USER=pokestore
DB_PASSWORD=pokestore123

# Mínimo 32 caracteres. Generar uno con:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120

CORS_ORIGINS=http://localhost:5173

# Swagger UI (/swagger-ui.html) y /v3/api-docs. Poner false en producción
SWAGGER_ENABLED=true

ADMIN_EMAIL=admin@pokestore.cl
ADMIN_PASSWORD=Admin1234
DEMO_USER_EMAIL=ash@pokemon.com
DEMO_USER_PASSWORD=Pikachu123
